{
  "version": 1,
  "name": "Perdido Peas",
  "publicDir": "public",
  "command": "npx open-assets render --force",
  "collections": [
    {
      "id": "characters",
      "label": "Character Sheet",
      "sourceSize": { "width": 1200, "height": 1200 },
      "borderRadius": 0,
      "templates": [
        { "src": "assets/characters/eric.html", "name": "eric", "label": "Eric" },
        { "src": "assets/characters/ian.html", "name": "ian", "label": "Ian" },
        { "src": "assets/characters/chris.html", "name": "chris", "label": "Chris" },
        { "src": "assets/characters/katie.html", "name": "katie", "label": "Katie" },
        { "src": "assets/characters/grace.html", "name": "grace", "label": "Grace" },
        { "src": "assets/characters/ben.html", "name": "ben", "label": "Ben" },
        { "src": "assets/characters/sarah.html", "name": "sarah", "label": "Sarah" },
        { "src": "assets/characters/crab.html", "name": "crab", "label": "Crab" },
        { "src": "assets/characters/seagull.html", "name": "seagull", "label": "Seagull" },
        { "src": "assets/characters/turtle.html", "name": "turtle", "label": "Turtle" },
        { "src": "assets/characters/pelican.html", "name": "pelican", "label": "Pelican" },
        { "src": "assets/characters/fish.html", "name": "fish", "label": "Fish" }
      ],
      "export": [
        { "name": "full", "label": "Full 1200", "size": { "width": 1200, "height": 1200 }, "outFile": "exports/characters/full/{template}.png" },
        { "name": "thumb", "label": "Thumb 512", "size": { "width": 512, "height": 512 }, "outFile": "exports/characters/thumb/{template}.png" }
      ],
      "customExport": { "defaultWidth": 1200, "defaultHeight": 1200 }
    },
    {
      "id": "pages",
      "label": "Book Pages",
      "sourceSize": { "width": 2550, "height": 2550 },
      "borderRadius": 0,
      "templates": [
        { "src": "assets/pages/00-cover.html", "name": "00-cover", "label": "Cover" },
        { "src": "assets/pages/01-dedication.html", "name": "01-dedication", "label": "Dedication" },
        { "src": "assets/pages/02-page-01.html", "name": "02-page-01", "label": "Page 1" },
        { "src": "assets/pages/03-page-02.html", "name": "03-page-02", "label": "Page 2" },
        { "src": "assets/pages/04-page-03.html", "name": "04-page-03", "label": "Page 3" },
        { "src": "assets/pages/05-page-04.html", "name": "05-page-04", "label": "Page 4" },
        { "src": "assets/pages/06-page-05.html", "name": "06-page-05", "label": "Page 5" },
        { "src": "assets/pages/07-page-06.html", "name": "07-page-06", "label": "Page 6" },
        { "src": "assets/pages/08-page-07.html", "name": "08-page-07", "label": "Page 7" },
        { "src": "assets/pages/09-page-08.html", "name": "09-page-08", "label": "Page 8" },
        { "src": "assets/pages/10-page-09.html", "name": "10-page-09", "label": "Page 9" },
        { "src": "assets/pages/11-page-10.html", "name": "11-page-10", "label": "Page 10" },
        { "src": "assets/pages/12-page-11.html", "name": "12-page-11", "label": "Page 11" },
        { "src": "assets/pages/13-page-12.html", "name": "13-page-12", "label": "Page 12" },
        { "src": "assets/pages/14-page-13.html", "name": "14-page-13", "label": "Page 13" },
        { "src": "assets/pages/15-page-14.html", "name": "15-page-14", "label": "Page 14" },
        { "src": "assets/pages/16-page-15.html", "name": "16-page-15", "label": "Page 15" },
        { "src": "assets/pages/17-page-16.html", "name": "17-page-16", "label": "Page 16" },
        { "src": "assets/pages/18-page-17.html", "name": "18-page-17", "label": "Page 17" },
        { "src": "assets/pages/19-back-cover.html", "name": "19-back-cover", "label": "Back Cover" }
      ],
      "export": [
        { "name": "print", "label": "Print 2550", "size": { "width": 2550, "height": 2550 }, "outFile": "exports/pages/{template}.png" },
        { "name": "web", "label": "Web Reader 1600", "size": { "width": 1600, "height": 1600 }, "outFile": "web/public/pages/{template}.png" }
      ],
      "customExport": { "defaultWidth": 2550, "defaultHeight": 2550 }
    },
    {
      "id": "og",
      "label": "OG Image",
      "sourceSize": { "width": 2560, "height": 1344 },
      "borderRadius": 0,
      "templates": [
        { "src": "assets/og/og-cover.html", "name": "og-cover", "label": "OG Cover" }
      ],
      "export": [
        { "name": "og", "label": "OG 1200x630", "size": { "width": 1200, "height": 630 }, "outFile": "exports/og/{template}.png" },
        { "name": "web-og", "label": "Web opengraph-image", "size": { "width": 1200, "height": 630 }, "outFile": "web/app/opengraph-image.png" }
      ],
      "customExport": { "defaultWidth": 1200, "defaultHeight": 630 }
    },
    {
      "id": "lineup",
      "label": "Crew Lineup",
      "sourceSize": { "width": 2900, "height": 540 },
      "borderRadius": 0,
      "templates": [
        { "src": "assets/characters/lineup.html", "name": "lineup", "label": "The Perdido Peas" }
      ],
      "export": [
        { "name": "review", "label": "Review 2088", "size": { "width": 2088, "height": 389 }, "outFile": "exports/lineup/{template}.png" }
      ],
      "customExport": { "defaultWidth": 2900, "defaultHeight": 540 }
    },
    {
      "id": "banner",
      "label": "README Banner",
      "sourceSize": { "width": 1280, "height": 640 },
      "borderRadius": 0,
      "templates": [
        { "src": "assets/banner/banner.html", "name": "banner", "label": "Home Page Banner" }
      ],
      "export": [
        { "name": "readme", "label": "README 2x", "size": { "width": 2560, "height": 1280 }, "outFile": "public/banner/banner.png" }
      ],
      "customExport": { "defaultWidth": 1280, "defaultHeight": 640 }
    }
  ]
}
